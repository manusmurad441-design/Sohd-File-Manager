{
  "format_version": "0.1",
  "id": "org.sohdow.settings",
  "name": "Sohd Settings",
  "version": "0.1.0",
  "developer": {
    "name": "Sohdow Project"
  },
  "description": "Native local settings and system information for the Sohdow ecosystem.",
  "icon": "icon.png",
  "entry_point": "app/main.py",

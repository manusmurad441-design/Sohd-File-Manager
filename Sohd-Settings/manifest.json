  "permissions": [
    "system.info",
    "system.display",
    "system.audio",
    "system.network",
    "filesystem.read",
    "filesystem.write",
    "process.launch"
  ],
  "dependencies": {},
  "min_sohdow_version": "0.1.0"
}
